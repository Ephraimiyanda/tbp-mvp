NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: cron that marks Meet links joinable at session time
CRON_SECRET=change-me

# Optional: Google Calendar API (Workspace) to mint Meet links.
# If unset, the professional pastes a Meet URL when scheduling.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
