NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# On Vercel: https://myola-health.vercel.app (never localhost).
# Strongly recommended: auto-confirms signup with no email link.
# Without it, turn off Confirm email in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Google Calendar API (Workspace) to mint Meet links.
# If unset, the professional pastes a Meet URL when scheduling.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
